# Plantilla para el despliegue a producción (Cloudflare Pages).
# Copia a `.env.production` (ignorado por git) y completa los valores del tenant de PRD.
# Todos los valores son públicos: NUNCA pongas aquí secretos ni certificados (CLAUDE.md §3.2).
VITE_APP_ENV=prod
VITE_AUTH_MODE=msal

# Entra ID - App Registration de PRD (docs/06)
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# SharePoint de PRD
VITE_SHAREPOINT_SITE_URL=https://TU-TENANT.sharepoint.com/sites/ServicioTecnicoBC
VITE_SHAREPOINT_SITE_NAME=ServicioTecnicoBC
