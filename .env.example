# Ambiente de la aplicacion
VITE_APP_ENV=dev

# Modo de autenticacion: 'mock' solo para pruebas/DEV. 'msal' es el valor de produccion.
VITE_AUTH_MODE=mock

# Entra ID - App Registration (valores publicos)
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# SharePoint
VITE_SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/ServicioTecnicoBC-DEV
VITE_SHAREPOINT_SITE_NAME=ServicioTecnicoBC-DEV
