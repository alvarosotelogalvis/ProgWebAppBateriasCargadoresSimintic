{
  "name": "servicio-tecnico-baterias-cargadores",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "preview": "vite preview",
    "preview:dev": "vite preview --mode development",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "check:build-mock": "node scripts/check-build-mock.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:build-mock && npm run test -- --run",
    "deploy:dev": "wrangler pages deploy dist --project-name st-bc-dev",
    "deploy:prod": "wrangler pages deploy dist --project-name st-bc-prod",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.30.0",
    "@fontsource/montserrat": "^5.1.0",
    "@internationalized/date": "^3.6.0",
    "@material-symbols/svg-500": "^0.27.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "fflate": "0.8.3",
    "i18next": "^23.16.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.4.1",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^7.0.0",
    "workbox-window": "^7.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.13.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.11.0",
    "husky": "^9.1.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.0",
    "msw": "^2.15.0",
    "prettier": "^3.3.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vite-plugin-svgr": "^4.2.0",
    "vitest": "^2.1.0"
  }
}
